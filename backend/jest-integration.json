{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "test/(testcontainers|integration|e2e)/.+\\.spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "globalSetup": "<rootDir>/test/testcontainers/global-setup.ts",
  "globalTeardown": "<rootDir>/test/testcontainers/global-teardown.ts",
  "testTimeout": 120000,
  "forceExit": true,
  "detectOpenHandles": true,
  "coverageDirectory": "../coverage/integration",
  "collectCoverageFrom": ["src/**/*.ts", "!src/**/*.spec.ts", "!src/**/*.d.ts"]
}
